    "rule": "F6 dual-register: kernel/audit surfaces emit MARUAH; UI chips/prose emit EMPATHY"
  },
  "mission_footer": {
    "background": "var(--paper)",
    "content": [
      { "label": "doctrine", "value": "Ditempa Bukan Diberi" },
      { "label": "missions", "value": "six verbs" },
      { "label": "kernel", "value": "arifOS F1–F13" }
    ]
