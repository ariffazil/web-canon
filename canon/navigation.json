      },
      {
        "label": "INSTITUTION",
        "href": "/institution",
        "scope": "INSTITUTION",
        "accent": "yellow",
        "lede": "WEALTH + arifOS · A-FORGE · AAA — DRAFT",
        "role": "trinity-2"
      },
      {
        "label": "EARTH",
        "href": "/earth",
        "scope": "EARTH",
        "accent": "teal",
        "lede": "GEOX + membrane — live path /earth already used in primary",
