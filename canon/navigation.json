  "breadcrumb": {
    "source": "generated_from_url_path",
    "voice": "mono",
    "separator": "›",
    "rule": "disagreement between breadcrumb and URL = drift",
    "examples": [
      { "url": "/", "breadcrumb": "home" },
      { "url": "/earth", "breadcrumb": "home › earth" },
      { "url": "/economics", "breadcrumb": "home › economics" },
      { "url": "/world/makcikgpt", "breadcrumb": "home › world › makcikgpt" },
      { "url": "/politics/ns-election", "breadcrumb": "home › politics › ns-election" },
      { "url": "/vitals/", "breadcrumb": "home › vitals" },
      { "url": "/doctrine", "breadcrumb": "home › doctrine" },
      { "url": "/missions", "breadcrumb": "home › missions" }
    ]
  },
  "keyboard_shortcuts": [
    { "combo": "g e", "action": "navigate to /earth" },
    { "combo": "g c", "action": "navigate to /economics" },
    { "combo": "g w", "action": "navigate to /world" },
    { "combo": "g r", "action": "navigate to /writing" },
    { "combo": "g d", "action": "navigate to /doctrine" },
    { "combo": "g m", "action": "navigate to /missions" },
    { "combo": "g 9", "action": "navigate to /999/" },
    { "combo": "g v", "action": "navigate to /vitals/" },
    { "combo": "g p", "action": "navigate to /politics/ns-election/" },
    { "combo": "?", "action": "show shortcut overlay" },
    { "combo": "Esc", "action": "close overlays" }
