    "rule": "Max 7. Logo is brand, not a primary item. Politics lives in secondary (World civic depth). Commodities ⊆ World.",
    "items": [
      { "label": "Earth", "href": "/earth", "role": "primary", "mode": "spa" },
      { "label": "Economics", "href": "/economics", "role": "primary", "mode": "spa" },
      { "label": "World", "href": "/world", "role": "primary", "mode": "spa" },
      { "label": "Writing", "href": "/writing", "role": "primary", "mode": "spa", "aliases": ["/read", "/essays"] },
      { "label": "Doctrine", "href": "/doctrine", "role": "primary", "mode": "spa", "aliases": ["/canon", "/federation"] },
      { "label": "Missions", "href": "/missions", "role": "primary", "mode": "spa" },
      { "label": "999", "href": "/999/", "role": "primary", "mode": "static" }
    ]
  },
  "secondary_links": {
    "description": "Footer human secondary — real live surfaces, not aspirational paths",
    "items": [
      { "label": "Politics · NS", "href": "/politics/ns-election/", "role": "secondary", "mode": "spa" },
      { "label": "VITALS · PETRONAS", "href": "/vitals/", "role": "secondary", "mode": "static" },
      { "label": "Read", "href": "/read", "role": "secondary", "mode": "spa" },
      { "label": "000 Genesis", "href": "/000/", "role": "secondary", "mode": "static" },
      { "label": "Map", "href": "/map/", "role": "secondary", "mode": "static" },
      { "label": "Connect", "href": "https://mcp.arif-fazil.com/", "role": "secondary", "mode": "external" }
    ]
  },
  "machine_links": {
    "description": "Quiet machine doors — agents and WebMCP",
    "items": [
      { "label": "llms.txt", "href": "/llms.txt" },
      { "label": "missions.json", "href": "/missions.json" },
      { "label": "surfaces.json", "href": "/surfaces.json" },
      { "label": "webmcp", "href": "/.well-known/webmcp.json" },
      { "label": "mcp", "href": "https://mcp.arif-fazil.com/mcp" },
      { "label": "did", "href": "/.well-known/did.json" },
      { "label": "PyPI arifos", "href": "https://pypi.org/project/arifos/" }
    ]
  },
  "trinity_nav": {
    "status": "DRAFT_FUTURE",
    "rule": "Do not render on public shell until /human /institution paths are live product surfaces.",
    "tiles": [
      {
        "label": "HUMAN",
        "href": "/human",
        "scope": "HUMAN",
        "accent": "red",
