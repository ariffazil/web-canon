{
  "$schema": "./public-state.schema.json",
  "version": "4.0.0",
  "as_of": "2026-08-04",
  "description": "Hybrid IA — Arrow-of-Time shell + live route graph. One primary strip. Trinity is DRAFT only.",
  "rule": "Edit primary_links / secondary_links / machine_links here. Site generates navCanon.ts and MUST render them. No hardcoded navbar lists.",
  "doctrine": {
    "human_first": true,
    "agent_doors": "footer machine_links + /.well-known/* + llms.txt + missions.json",
    "preserve": [
      "politics/ns-election",
      "world/makcikgpt",
      "commodities oil|gas|gold|klci|usdmyr",
      "vitals PETRONAS singleton",
      "000 genesis",
      "999 vault"
    ]
  },
  "frame": {
    "name": "arrow_hybrid_frame",
    "applies_to": "every_public_page",
    "order": [
      "brand_clock_strip",
      "primary_nav",
      "page_content",
      "secondary_footer",
      "machine_footer"
    ],
    "status": "LIVE"
  },
  "brand": {
    "label": "ARIF FAZIL",
    "href": "/",
    "clock": "Asia/Kuala_Lumpur",
    "creed": "Forged, not given."
  },
