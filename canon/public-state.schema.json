{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arifos.arif-fazil.com/.well-known/public-state.schema.json",
  "title": "arifOS Federation Public State Schema",
  "description": "Validates the public-state.json emitted by the Observatory and consumed by the MCP Gateway and organ sites.",
  "type": "object",
  "required": ["version", "observed_at", "organs", "trinity"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "observed_at": { "type": "string", "format": "date-time" },
    "federation": { "type": "string" },
    "organs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "health"],
        "properties": {
          "id": { "type": "string" },
          "port": { "type": "integer" },
          "role": { "type": "string" },
          "health": { "type": "string", "enum": ["healthy", "degraded", "down", "unknown"] },
          "tool_count": { "type": "integer" },
          "version": { "type": "string" }
        }
      }
    },
    "trinity": {
      "type": "object",
      "required": ["soul", "mind", "body"],
      "properties": {
        "soul": { "type": "object", "properties": { "host": { "type": "string" }, "health": { "type": "string" } } },
        "mind": { "type": "object", "properties": { "host": { "type": "string" }, "health": { "type": "string" } } },
        "body": { "type": "object", "properties": { "host": { "type": "string" }, "health": { "type": "string" } } }
      }
    }
  }
}
